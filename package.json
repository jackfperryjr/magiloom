{
  "name": "magiloom",
  "version": "0.0.0",
  "description": "Magiloom — A modern DragonRealms front-end",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "build-ico": "node scripts/build-ico.js",
    "social-preview": "node scripts/capture-social-preview.js",
    "screenshots": "node scripts/capture-screenshots.js",
    "package": "node scripts/build-ico.js && electron-vite build && electron-builder",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "tools:dev": "vite --config vite.tools.config.ts",
    "tools:build": "vite build --config vite.tools.config.ts",
    "tools:preview": "vite preview --config vite.tools.config.ts",
    "test:tools": "node scripts/run-tests.js",
    "map:build-rooms": "node scripts/build-rooms.js",
    "map:check": "node scripts/check-dataset.js",
    "map:bake": "node scripts/bake-layouts.js",
    "map:all": "npm run map:build-rooms && npm run map:bake && npm run map:check"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "jotai": "^2.8.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.8.0",
    "jimp": "^0.22.12",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.magiloom.dragonrealms",
    "productName": "Lantern",
    "icon": "resources/icon.png",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/update.html",
        "to": "update.html"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/map-data",
        "to": "map-data"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "jackfperryjr",
      "repo": "magiloom"
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lantern"
    },
    "dmg": {
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}.${ext}"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
